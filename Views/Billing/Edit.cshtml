@model UniqueStudio.Models.Billing

@{
    ViewData["Title"] = "Edit Billing";
}

<h1>Edit Billing</h1>

<h4>Billing</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="BillingId" />

            <div class="form-group mb-3">
                <label asp-for="BookingId" class="control-label">Select Booking</label>
                <select asp-for="BookingId" class="form-control" asp-items="ViewBag.BookingId">
                    <option value="">-- Select Booking --</option>
                </select>
                <span asp-validation-for="BookingId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="TotalAmount" class="control-label">Total Amount</label>
                <input asp-for="TotalAmount" class="form-control" />
                <span asp-validation-for="TotalAmount" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="PaidAmount" class="control-label">Paid Amount</label>
                <input asp-for="PaidAmount" class="form-control" />
                <span asp-validation-for="PaidAmount" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="PaymentStatus" class="control-label">Payment Status</label>
                <input asp-for="PaymentStatus" class="form-control" />
                <span asp-validation-for="PaymentStatus" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}