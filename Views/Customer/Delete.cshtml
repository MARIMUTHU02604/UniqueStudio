@model UniqueStudioMvc.Models.Customer

@{
    ViewData["Title"] = "Delete Customer";
}

<div class="container mt-4">
    <h2>Delete Customer</h2>
    <h3 class="text-danger">Are you sure you want to delete this?</h3>
    <div>
        <hr />
        <dl class="row">
            <dt class="col-sm-2">Customer ID</dt>
            <dd class="col-sm-10">@Model.CustomerId</dd>

            <dt class="col-sm-2">Customer Name</dt>
            <dd class="col-sm-10">@Model.CustomerName</dd>

            <dt class="col-sm-2">Email</dt>
            <dd class="col-sm-10">@Model.Email</dd>

            <dt class="col-sm-2">Phone</dt>
            <dd class="col-sm-10">@Model.Phone</dd>

            <dt class="col-sm-2">Address</dt>
            <dd class="col-sm-10">@Model.Address</dd>
        </dl>

        <form asp-action="Delete">
            <input type="hidden" asp-for="CustomerId" />
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </form>
    </div>
</div>