@model IEnumerable<UniqueStudio.Models.Event>

@{
    ViewData["Title"] = "Events List";
}

<h2>Events List</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New Event</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Event ID</th>
            <th>Booking ID</th>
            <th>Event Date</th>
            <th>Location</th>
            <th>Photographer</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.EventId</td>
                <td>@item.BookingId</td>
                <td>@item.EventDate.ToString("yyyy-MM-dd HH:mm")</td>
                <td>@item.Location</td>
                <td>@item.Photographer</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.EventId" class="btn btn-sm btn-warning">Edit</a> |
                    <form asp-action="DeleteConfirmed" asp-route-id="@item.EventId" method="post" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this event?');">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>