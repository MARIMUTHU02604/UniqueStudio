@model UniqueStudioMvc.Models.Package

@{
    ViewData["Title"] = "Delete Package";
}

<div class="container mt-4">
    <h2>Delete Package</h2>
    <h3 class="text-danger">Are you sure you want to delete this package?</h3>
    <div>
        <hr />
        <dl class="row">
            <dt class="col-sm-2">Package ID</dt>
            <dd class="col-sm-10">@Model.PackageId</dd>

            <dt class="col-sm-2">Package Name</dt>
            <dd class="col-sm-10">@Model.PackageName</dd>

            <dt class="col-sm-2">Price</dt>
            <dd class="col-sm-10">@Model.Price</dd>

            <dt class="col-sm-2">Description</dt>
            <dd class="col-sm-10">@Model.Description</dd>
        </dl>

        <form asp-action="Delete">
            <input type="hidden" asp-for="PackageId" />
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </form>
    </div>
</div>