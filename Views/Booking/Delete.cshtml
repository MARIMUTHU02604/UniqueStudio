@model UniqueStudio.Models.Booking

@{
    ViewBag.Title = "Delete Booking";
}

<div class="container mt-4">
    <h2>Delete Booking</h2>
    <h3 class="text-danger">Are you sure you want to delete this?</h3>
    <hr />

    <div>
        <dl class="row">
            <dt class="col-sm-2">Customer</dt>
            <dd class="col-sm-10">@Model.CustomerName</dd>

            <dt class="col-sm-2">Package</dt>
            <dd class="col-sm-10">@Model.PackageName</dd>

            <dt class="col-sm-2">Booking Date</dt>
            <dd class="col-sm-10">@Model.BookingDate.ToString("yyyy-MM-dd")</dd>

            <dt class="col-sm-2">Total Amount</dt>
            <dd class="col-sm-10">@Model.TotalAmount</dd>

            <dt class="col-sm-2">Status</dt>
            <dd class="col-sm-10">@Model.Status</dd>
        </dl>

        @using (Html.BeginForm("Delete", "Booking", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(model => model.BookingId)

            <button type="submit" class="btn btn-danger">Delete</button>
            <a href="@Url.Action("Index", "Booking")" class="btn btn-secondary ml-2" style="margin-left: 10px;">Back to List</a>
        }
    </div>
</div>